<Layouts.flash_group flash={@flash} />

<main class="min-h-screen bg-base-200 px-4 py-6">
  <div class="mx-auto max-w-5xl">
    <header class="mb-5 flex items-center justify-between border-b border-base-300 pb-5">
      <div>
        <p class="text-sm font-semibold text-secondary">Admin</p>
        <h1 class="text-3xl font-bold">ユーザー管理</h1>
      </div>
      <a class="btn btn-ghost" href={~p"/tweet"}>戻る</a>
    </header>

    <section class="mb-5 grid gap-3 sm:grid-cols-2">
      <div class="rounded-lg border border-base-300 bg-base-100 p-4">
        <p class="text-sm text-base-content/60">総投稿数</p>
        <p class="text-3xl font-bold">{@total_tweets}</p>
      </div>
      <div class="rounded-lg border border-base-300 bg-base-100 p-4">
        <p class="text-sm text-base-content/60">総いいね数</p>
        <p class="text-3xl font-bold">{@total_likes}</p>
      </div>
    </section>

    <section class="overflow-x-auto rounded-lg border border-base-300 bg-base-100">
      <table class="table">
        <thead>
          <tr>
            <th>ユーザー</th>
            <th>メール</th>
            <th>投稿</th>
            <th>いいね</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <%= for user <- @users do %>
            <tr>
              <td>
                <span class="font-semibold">{user.name}</span>
                <span :if={user.is_admin} class="badge badge-primary ml-2">admin</span>
              </td>
              <td>
                <form
                  action={~p"/admin/users/#{user.id}/email"}
                  method="post"
                  class="flex min-w-72 gap-2"
                >
                  <input type="hidden" name="_method" value="put" />
                  <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                  <input class="input input-sm flex-1" name="user[email]" value={user.email} />
                  <button class="btn btn-sm" type="submit">保存</button>
                </form>
              </td>
              <td>{user.tweets_count}</td>
              <td>{user.received_likes_count}</td>
              <td>
                <form :if={!user.is_admin} action={~p"/admin/users/#{user.id}"} method="post">
                  <input type="hidden" name="_method" value="delete" />
                  <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                  <button class="btn btn-sm btn-ghost text-error" type="submit">削除</button>
                </form>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  </div>
</main>
