<Layouts.flash_group flash={@flash} />

<main class="min-h-screen bg-base-200 px-4 py-6 text-base-content sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <header class="mb-6 border-b border-base-300 pb-5">
      <p class="text-sm font-semibold text-secondary">Phoenix replacement</p>
      <h1 class="text-3xl font-bold">つぶやきを編集</h1>
    </header>

    <section class="rounded-lg border border-base-300 bg-base-100 p-4 shadow-sm">
      <.form for={@form} action={~p"/tweet/#{@tweet.id}"} method="put" multipart class="space-y-3">
        <.input field={@form[:content]} type="textarea" label="本文" />
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="label cursor-pointer justify-start gap-3 rounded border border-base-300 px-3 py-2">
            <input
              type="checkbox"
              class="checkbox checkbox-sm"
              name="tweet[is_secret]"
              value="1"
              checked={@tweet.is_secret}
            />
            <span class="label-text">秘密投稿にする</span>
          </label>
          <label class="label cursor-pointer justify-start gap-3 rounded border border-base-300 px-3 py-2">
            <input
              type="checkbox"
              class="checkbox checkbox-sm"
              name="tweet[is_protected]"
              value="1"
              checked={@tweet.is_protected}
            />
            <span class="label-text">保護する</span>
          </label>
        </div>
        <.input field={@form[:scheduled_at]} type="datetime-local" label="予約日時" />
        <div>
          <label class="label" for="tweet_images">画像を追加</label>
          <input
            id="tweet_images"
            class="file-input w-full"
            type="file"
            name="tweet[images][]"
            multiple
            accept="image/*"
          />
        </div>
        <div :if={@tweet.images != []} class="grid grid-cols-2 gap-2 sm:grid-cols-3">
          <img
            :for={image <- @tweet.images}
            class="aspect-square rounded object-cover"
            src={"/uploads/#{image.name}"}
            alt=""
          />
        </div>
        <div class="flex justify-between gap-3">
          <a class="btn btn-ghost" href={~p"/tweet"}>戻る</a>
          <button class="btn btn-primary" type="submit">更新</button>
        </div>
      </.form>
    </section>
  </div>
</main>
