<Layouts.flash_group flash={@flash} />

<main class="min-h-screen bg-base-200 px-4 py-6 text-base-content sm:px-6 lg:px-8">
  <div class="mx-auto max-w-3xl">
    <header class="mb-6 flex flex-col gap-3 border-b border-base-300 pb-5 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-semibold text-secondary">Phoenix replacement</p>
        <h1 class="text-3xl font-bold">つぶやきアプリ</h1>
      </div>
      <div class="flex flex-wrap items-center gap-3 text-sm text-base-content/70">
        <span>投稿 {@total_count} 件</span>
        <%= if @conn.assigns.current_user do %>
          <span class="rounded-full bg-base-100 px-2 py-1">
            {@conn.assigns.current_user.name}
          </span>
          <a class="btn btn-sm btn-ghost" href={~p"/account"}>アカウント</a>
          <a
            :if={@conn.assigns.current_user.is_admin}
            class="btn btn-sm btn-ghost"
            href={~p"/admin/users"}
          >
            管理
          </a>
          <form action={~p"/logout"} method="post">
            <input type="hidden" name="_method" value="delete" />
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <button class="btn btn-sm btn-ghost" type="submit">ログアウト</button>
          </form>
        <% else %>
          <a class="btn btn-sm btn-primary" href={~p"/login"}>ログイン</a>
          <a class="btn btn-sm btn-ghost" href={~p"/register"}>登録</a>
        <% end %>
        <Layouts.theme_toggle />
      </div>
    </header>

    <%= if @conn.assigns.current_user do %>
      <section class="mb-5 rounded-lg border border-base-300 bg-base-100 p-4 shadow-sm">
        <.form for={@form} action={~p"/tweet"} multipart class="space-y-3">
          <.input
            field={@form[:content]}
            type="textarea"
            label="いまどうしてる？"
            placeholder="255文字以内で入力"
          />
          <div>
            <label class="label" for="tweet_images">画像</label>
            <input
              id="tweet_images"
              class="file-input w-full"
              type="file"
              name="tweet[images][]"
              multiple
              accept="image/*"
            />
          </div>
          <div class="flex justify-end">
            <button class="btn btn-primary" type="submit">投稿</button>
          </div>
        </.form>
      </section>
    <% else %>
      <section class="mb-5 rounded-lg border border-base-300 bg-base-100 p-4 text-sm text-base-content/70 shadow-sm">
        投稿やいいねにはログインが必要です。
      </section>
    <% end %>

    <section class="overflow-hidden rounded-lg border border-base-300 bg-base-100 shadow-sm">
      <%= if Enum.empty?(@tweets) do %>
        <p class="p-8 text-center text-base-content/60">まだ投稿がありません。</p>
      <% else %>
        <ul class="divide-y divide-base-300">
          <%= for tweet <- @tweets do %>
            <li class="p-4">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0 flex-1">
                  <div class="mb-2 flex flex-wrap items-center gap-2">
                    <span class="rounded-full bg-base-200 px-2 py-1 text-xs font-semibold">
                      {tweet.user.name}
                    </span>
                    <span class="text-xs text-base-content/50">
                      {format_datetime(tweet.inserted_at)}
                    </span>
                  </div>
                  <p class="whitespace-pre-wrap break-words leading-7">{tweet.content}</p>
                  <div :if={tweet.images != []} class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
                    <img
                      :for={image <- tweet.images}
                      class="aspect-square rounded object-cover"
                      src={"/uploads/#{image.name}"}
                      alt=""
                    />
                  </div>
                </div>

                <div class="flex shrink-0 items-center gap-2">
                  <%= if @conn.assigns.current_user do %>
                    <form action={~p"/tweet/#{tweet.id}/like"} method="post">
                      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                      <button
                        class={[
                          "btn btn-sm gap-1",
                          if(tweet.liked_by_demo_user, do: "btn-error", else: "btn-ghost")
                        ]}
                        type="submit"
                        title="いいね"
                      >
                        <span aria-hidden="true">♡</span>
                        <span>{tweet.like_count}</span>
                      </button>
                    </form>
                  <% else %>
                    <span class="btn btn-sm btn-ghost gap-1 pointer-events-none">
                      <span aria-hidden="true">♡</span>
                      <span>{tweet.like_count}</span>
                    </span>
                  <% end %>

                  <%= if @conn.assigns.current_user && (@conn.assigns.current_user.id == tweet.user_id || @conn.assigns.current_user.is_admin) do %>
                    <a class="btn btn-sm btn-ghost" href={~p"/tweet/#{tweet.id}/edit"}>編集</a>

                    <form action={~p"/tweet/#{tweet.id}"} method="post">
                      <input type="hidden" name="_method" value="delete" />
                      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                      <button class="btn btn-sm btn-ghost text-error" type="submit">削除</button>
                    </form>
                  <% end %>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </div>
</main>
